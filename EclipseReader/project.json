{
  "name": "EclipseReader",
  "options": {
    "minimumXcodeGenVersion": "2.44.1",
    "xcodeVersion": "27.1",
    "deploymentTarget": {
      "iOS": "17.0"
    },
    "createIntermediateGroups": true
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "6.0",
      "SWIFT_STRICT_CONCURRENCY": "complete",
      "CODE_SIGNING_ALLOWED": "NO",
      "CODE_SIGNING_REQUIRED": "NO",
      "CODE_SIGN_IDENTITY": "",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "APP_BUNDLE_ID": "com.personal.eclipse.reader",
      "APP_DISPLAY_NAME": "eclipsereader",
      "MARKETING_VERSION": "1.0.0",
      "CURRENT_PROJECT_VERSION": "2",
      "ENABLE_USER_SCRIPT_SANDBOXING": "YES"
    }
  },
  "targets": {
    "EclipseReader": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "Sources/Core",
        "Sources/App",
        {
          "path": "Resources",
          "excludes": [
            "Info.plist"
          ]
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(APP_BUNDLE_ID)",
          "INFOPLIST_FILE": "Resources/Info.plist",
          "GENERATE_INFOPLIST_FILE": "NO",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
          "SUPPORTS_MACCATALYST": "NO"
        }
      }
    },
    "EclipseReaderUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        "Tests/AppUITests"
      ],
      "dependencies": [
        {
          "target": "EclipseReader"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(APP_BUNDLE_ID).uitests",
          "GENERATE_INFOPLIST_FILE": "YES",
          "TEST_TARGET_NAME": "EclipseReader"
        }
      }
    },
    "EclipseReaderAppTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": [
        "Tests/AppTests"
      ],
      "dependencies": [
        {
          "target": "EclipseReader"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(APP_BUNDLE_ID).apptests",
          "GENERATE_INFOPLIST_FILE": "YES",
          "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/EclipseReader.app/EclipseReader",
          "BUNDLE_LOADER": "$(TEST_HOST)",
          "SWIFT_STRICT_CONCURRENCY": "minimal"
        }
      }
    }
  },
  "schemes": {
    "EclipseReader": {
      "build": {
        "targets": {
          "EclipseReader": "all",
          "EclipseReaderUITests": [
            "test"
          ],
          "EclipseReaderAppTests": [
            "test"
          ]
        }
      },
      "test": {
        "targets": [
          "EclipseReaderUITests",
          "EclipseReaderAppTests"
        ],
        "gatherCoverageData": false
      },
      "run": {
        "config": "Debug"
      },
      "archive": {
        "config": "Release"
      }
    }
  }
}